{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Grammar contract (this fork's addition; format tree-sitter-contract-fork/grammar-contract/3)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "variables",
    "terminals",
    "external_tokens",
    "extras",
    "word_token",
    "default_aliases",
    "node_kinds"
  ],
  "properties": {
    "format": {
      "const": "tree-sitter-contract-fork/grammar-contract/3"
    },
    "variables": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Variable"
      }
    },
    "terminals": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Terminal"
      }
    },
    "external_tokens": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ExternalToken"
      }
    },
    "extras": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/SymbolRef"
      }
    },
    "word_token": {
      "oneOf": [
        {
          "$ref": "#/definitions/SymbolRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "default_aliases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "symbol",
          "alias"
        ],
        "properties": {
          "symbol": {
            "$ref": "#/definitions/SymbolRef"
          },
          "alias": {
            "$ref": "#/definitions/Alias"
          }
        }
      }
    },
    "node_kinds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "named"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "named": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "definitions": {
    "Kind": {
      "enum": [
        "named",
        "anonymous",
        "hidden",
        "auxiliary"
      ]
    },
    "SymbolRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "index"
      ],
      "properties": {
        "kind": {
          "enum": [
            "terminal",
            "non_terminal",
            "external",
            "end",
            "end_of_non_terminal_extra"
          ]
        },
        "index": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "Alias": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "named"
      ],
      "properties": {
        "value": {
          "type": "string"
        },
        "named": {
          "type": "boolean"
        }
      }
    },
    "ExternalToken": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "named",
            "anonymous",
            "hidden"
          ]
        }
      }
    },
    "Terminal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "rule"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/Kind"
        },
        "rule": {
          "$ref": "#/definitions/Rule"
        }
      }
    },
    "Variable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "form",
        "rule",
        "productions"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "form": {
          "enum": [
            "named",
            "anonymous",
            "hidden",
            "supertype",
            "inline",
            "repetition"
          ]
        },
        "subtypes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "named"
            ],
            "properties": {
              "type": {
                "type": "string"
              },
              "named": {
                "type": "boolean"
              }
            }
          }
        },
        "rule": {
          "$ref": "#/definitions/Rule"
        },
        "productions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Production"
          }
        }
      },
      "if": {
        "properties": {
          "form": {
            "const": "supertype"
          }
        }
      },
      "then": {
        "required": [
          "subtypes"
        ]
      },
      "else": {
        "not": {
          "required": [
            "subtypes"
          ]
        }
      }
    },
    "Production": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps",
        "requires_eof"
      ],
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "symbol"
            ],
            "properties": {
              "symbol": {
                "$ref": "#/definitions/SymbolRef"
              },
              "alias": {
                "$ref": "#/definitions/Alias"
              },
              "field": {
                "type": "string"
              }
            }
          }
        },
        "requires_eof": {
          "type": "boolean"
        }
      }
    },
    "Rule": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "blank",
                "eof"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "symbol"
          ],
          "properties": {
            "type": {
              "const": "symbol"
            },
            "symbol": {
              "$ref": "#/definitions/SymbolRef"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "string"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value",
            "flags"
          ],
          "properties": {
            "type": {
              "const": "pattern"
            },
            "value": {
              "type": "string"
            },
            "flags": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "name"
          ],
          "properties": {
            "type": {
              "const": "named_symbol"
            },
            "name": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "members"
          ],
          "properties": {
            "type": {
              "enum": [
                "seq",
                "choice"
              ]
            },
            "members": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Rule"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "content"
          ],
          "properties": {
            "type": {
              "const": "repeat"
            },
            "content": {
              "$ref": "#/definitions/Rule"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "is_token",
            "is_main_token",
            "content"
          ],
          "properties": {
            "type": {
              "const": "metadata"
            },
            "alias": {
              "$ref": "#/definitions/Alias"
            },
            "field": {
              "type": "string"
            },
            "is_token": {
              "type": "boolean"
            },
            "is_main_token": {
              "type": "boolean"
            },
            "content": {
              "$ref": "#/definitions/Rule"
            }
          }
        }
      ]
    }
  }
}
